{
	"name": "view-ignored-vscode",
	"displayName": "View ignored",
	"version": "0.0.1",
	"description": "Retrieve list of files ignored/included by Git, NPM, Yarn, JSR, Deno, Bun, VSCE extension CLI and other tools.",
	"categories": [
		"Other",
		"SCM Providers"
	],
	"license": "MIT",
	"author": "Mopsgamer",
	"repository": {
		"type": "git",
		"url": "git://github.com/Mopsgamer/view-ignored-vscode.git"
	},
	"publisher": "Mopsgamer",
	"type": "module",
	"main": "./dist/extension.cjs",
	"scripts": {
		"vscode:prepublish": "bun run package",
		"compile": "bun run check-types && bun run lint && bun run fmt && node esbuild.js",
		"watch": "bun run --parallel \"watch:*\"",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "bun run check-types && bun run lint && node esbuild.js --production",
		"vsix": "vsce package --no-dependencies",
		"check-types": "tsc --noEmit",
		"check": "bun run check-types",
		"lint": "oxlint",
		"fmt": "oxfmt",
		"release": "semantic-release"
	},
	"dependencies": {
		"ms": "^2.1.3",
		"simple-icons": "^16.34.0",
		"view-ignored": "^0.13.1"
	},
	"devDependencies": {
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/ms": "latest",
		"@types/node": "22",
		"@types/vscode": "^1.140.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"conventional-changelog-conventionalcommits": "^10.4.1",
		"esbuild": "latest",
		"ovsx": "^1.2.0",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2"
	},
	"contributes": {
		"icons": {
			"view-ignored-npm": {
				"description": "NPM icon provided by View ignored",
				"default": {
					"fontCharacter": "\\f1eb",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-yarn": {
				"description": "Yarn icon provided by View ignored",
				"default": {
					"fontCharacter": "\\f72f",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-git": {
				"description": "Git icon provided by View ignored",
				"default": {
					"fontCharacter": "\\ee52",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-bun": {
				"description": "Bun icon provided by View ignored",
				"default": {
					"fontCharacter": "\\eba7",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-deno": {
				"description": "Deno icon provided by View ignored",
				"default": {
					"fontCharacter": "\\ece2",
					"fontPath": "./SimpleIcons.woff"
				}
			},
			"view-ignored-jsr": {
				"description": "JSR icon provided by View ignored",
				"default": {
					"fontCharacter": "\\efe1",
					"fontPath": "./SimpleIcons.woff"
				}
			}
		},
		"configuration": {
			"title": "View Ignored",
			"properties": {
				"viewIgnored.target": {
					"type": "string",
					"enum": [
						"None",
						"Git",
						"NPM",
						"Yarn v2+, Modern",
						"Yarn v1, Classic",
						"VSCE",
						"Bun",
						"Deno",
						"JSR"
					],
					"default": "Git",
					"description": "Default target system used to check for ignored/included file decorations."
				},
				"viewIgnored.invert": {
					"type": "string",
					"enum": [
						"ignored",
						"included",
						"both"
					],
					"default": "ignored",
					"description": "Filter mode for file decorations."
				}
			}
		},
		"commands": [
			{
				"title": "Disable decorations",
				"command": "viewIgnored.scan.clear",
				"category": "View ignored",
				"enablement": "viewIgnored.isReady && viewIgnored.isScanning",
				"icon": "$(search-stop)"
			},
			{
				"title": "Scan decorations",
				"command": "viewIgnored.scan",
				"category": "View ignored",
				"enablement": "viewIgnored.isReady && !viewIgnored.isScanning",
				"icon": "$(diff-ignored)"
			},
			{
				"title": "Explain ignoring reasons",
				"command": "viewIgnored.explain",
				"category": "View ignored",
				"enablement": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot",
				"icon": "$(question)"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "viewIgnored.explain",
					"group": "explainignoring",
					"when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot"
				}
			],
			"view/title": [
				{
					"command": "viewIgnored.scan.clear",
					"when": "view == workbench.explorer.fileView && viewIgnored.isReady && viewIgnored.isScanning",
					"group": "navigation"
				},
				{
					"command": "viewIgnored.scan",
					"when": "view == workbench.explorer.fileView && viewIgnored.isReady && !viewIgnored.isScanning",
					"group": "navigation"
				}
			]
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"icon": "images/view-ignored.png",
	"engines": {
		"vscode": "^1.140.0"
	}
}
